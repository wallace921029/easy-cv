# 初始化管理员用的一次性邀请码，不少于 8 位。
# 【必填】首次启动前必须修改；系统未初始化且此变量缺失或过短时，服务将拒绝启动。
# 初始化完成后该码立即失效，可以从本文件中删除。
ADMIN_INVITE_CODE=EASYCV00

# 宿主机监听地址。
# 默认 0.0.0.0（监听所有网卡）；接入 Nginx 后建议改为 127.0.0.1，只允许本机访问应用端口。
HOST_BIND=0.0.0.0

# 映射到宿主机的端口，访问地址为 http://<服务器IP>:<HOST_PORT>。
HOST_PORT=8000

# 单条文本大小上限（KB），默认 1024（即 1 MB）。
MAX_TEXT_SIZE_KB=1024

# 登录会话有效期（天），默认 30。每次访问自动续期。
SESSION_TTL_DAYS=30

# 是否位于反向代理（Nginx）之后，接受 true/false/1/0，默认 false。
# 接入 Nginx 时必须设为 true，否则限流会把所有请求当作同一来源，且无法判断 HTTPS。
TRUST_PROXY=false
